# frozen_string_literal: true

# Pins the exact ruby_llm major-boundary release, so a regression in 2.0.0
# itself stays distinguishable from a regression in the latest 2.x.
source "https://rubygems.org"

gemspec path: ".."

gem "ruby_llm", "2.0.0"

group :development, :test do
  gem "railties", ">= 7.1" # boots a throwaway app in spec/integration/railtie_boot_spec.rb
  gem "rake", "~> 13.0"
  gem "rspec", "~> 3.13"
  gem "simplecov", "~> 0.22"
  gem "webmock", "~> 3.25"
end
