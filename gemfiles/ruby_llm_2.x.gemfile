# frozen_string_literal: true

# Tracks the newest ruby_llm the gemspec allows. Catches upstream drift inside
# the 2.x line before adopters do.
source "https://rubygems.org"

gemspec path: ".."

group :development, :test do
  gem "railties", ">= 7.1" # boots a throwaway app in spec/integration/railtie_boot_spec.rb
  gem "rake", "~> 13.0"
  gem "rspec", "~> 3.13"
  gem "simplecov", "~> 0.22"
  gem "webmock", "~> 3.25"
end
