# frozen_string_literal: true

# Tracks the newest ruby_llm the gemspec allows. Catches upstream drift inside
# the 2.x line before adopters do.
source "https://rubygems.org"

gemspec path: ".."

group :development, :test do
  gem "rake", "~> 13.0"
  gem "rspec", "~> 3.13"
  gem "simplecov", "~> 0.22"
end
