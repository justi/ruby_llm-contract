# frozen_string_literal: true

# Pins the gemspec's ruby_llm floor, so a regression in the oldest release we
# allow stays distinguishable from a regression in the latest 2.x.
source "https://rubygems.org"

gemspec path: ".."

gem "ruby_llm", "2.1.1"

group :development, :test do
  gem "railties", ">= 7.1" # boots a throwaway app in spec/integration/railtie_boot_spec.rb
  gem "rake", "~> 13.0"
  gem "rspec", "~> 3.13"
  gem "simplecov", "~> 0.22"
  gem "webmock", "~> 3.25"
end
